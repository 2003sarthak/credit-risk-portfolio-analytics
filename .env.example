# Copy this file to .env for local development. Never commit real secrets.
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Add the Gemini key when the assistant is implemented.
GEMINI_API_KEY=
# Choose a Gemini model available on your account's free tier.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional PostgreSQL connection string for durable hosted review decisions.
# Leave empty to use a local SQLite file under data/processed.
DATABASE_URL=

